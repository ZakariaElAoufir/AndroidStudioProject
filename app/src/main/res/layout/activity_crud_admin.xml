<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Admin.CRUD_Admin">

    <!-- Bouton Retour stylisé -->
    <Button
        android:id="@+id/btnRetour"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Retour"
        android:textColor="@color/purple_500"
        android:drawableLeft="@drawable/ic_arrow_back"
        android:drawableTint="@color/purple_500"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <!-- RecyclerView avec style moderne -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/utilisateurRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:background="@color/grey_light"
        app:layout_constraintTop_toBottomOf="@id/btnRetour"
        app:layout_constraintBottom_toTopOf="@id/btnAjouter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bouton Ajouter modernisé -->
    <Button
        android:id="@+id/btnAjouter"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Ajouter"
        android:textColor="@color/white"
        android:drawableEnd="@drawable/ic_add"
        android:drawableTint="@color/white"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>